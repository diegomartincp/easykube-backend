apiVersion: apps/v1
kind: Deployment # Create a deployment
metadata:
  name: {{name}}-deployment # Set the name of the deployment
  namespace: default
spec:
  #replicas: 1
  selector:
    matchLabels:
      app: {{name}}
  template:
    metadata:
      labels:
        app: {{name}}
    spec:
      containers:
        - name: {{name}}
          image: postgres
          imagePullPolicy: "IfNotPresent"
          ports:
            - containerPort: 5432 # Exposing the container port 5432 for PostgreSQL client connections.
          envFrom:
            - configMapRef:
                name: {{name}}-secret # Using the ConfigMap postgres-secret
          volumeMounts:
            - mountPath: /var/lib/postgresql/data
              name: postgresdata
          #Caracterísicas para el autoescalado
          resources:
              limits:
                  cpu: 2000m
              requests:
                  cpu: 100m
      volumes:
        - name: postgresdata
          persistentVolumeClaim:
            claimName: {{name}}-volume-claim
