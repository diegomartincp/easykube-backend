apiVersion: v1
kind: PersistentVolume # Create PV
metadata:
  name: {{name}}-volume # Sets PV name
  namespace: default
  labels:
    type: local # Sets PV's type
    app: {{name}}
spec:
  storageClassName: {{name}}-storage
  capacity:
    storage: {{memory}}Gi # Sets PV's size
  accessModes:
    - ReadWriteMany
  hostPath:
    path: "/data/{{name}}" # Sets PV's host path
