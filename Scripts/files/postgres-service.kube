apiVersion: v1
kind: Service # Create service
metadata:
  name: {{name}}-service # Sets the service name
  namespace: default
  labels:
    app: {{name}} # Defines app to create service for
spec:
  type: LoadBalancer # Sets the service type
  ports:
    - port: 5432 # Sets the port to run the postgres application
  selector:
    app: {{name}}
