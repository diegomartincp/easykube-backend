apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{name}}-deployment
  namespace: default
  labels:
    app: {{name}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{name}}
  template:
    metadata:
      labels:
        app: {{name}}
    spec:
      containers:
      - name: {{name}}-container
        image: diegomartinc/{{image}}:latest
        ports:
        - containerPort: {{puerto}}
